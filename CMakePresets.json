{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "BUILD_GRAPHICS": "ON",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "BUILD_GRAPHICS": "ON",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "BUILD_GRAPHICS": "OFF",
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-x64-base",
      "hidden": true,
      "inherits": "windows-base",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "not",
            "condition": {
              "type": "anyOf",
              "conditions": [
                {
                  "type": "equals",
                  "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                  "rhs": "ARM64"
                },
                {
                  "type": "equals",
                  "lhs": "$env{PROCESSOR_ARCHITEW6432}",
                  "rhs": "ARM64"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "windows-arm64-base",
      "hidden": true,
      "inherits": "windows-base",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "anyOf",
            "conditions": [
              {
                "type": "equals",
                "lhs": "$env{PROCESSOR_ARCHITECTURE}",
                "rhs": "ARM64"
              },
              {
                "type": "equals",
                "lhs": "$env{PROCESSOR_ARCHITEW6432}",
                "rhs": "ARM64"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "x64-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-x64-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-release",
      "displayName": "Windows x64 Release",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-arm64-debug",
      "displayName": "Windows ARM64 Debug",
      "inherits": "windows-arm64-base",
      "architecture": {
        "value": "ARM64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-windows"
      }
    },
    {
      "name": "windows-arm64-release",
      "displayName": "Windows ARM64 Release",
      "inherits": "windows-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS ARM64 Debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS ARM64 Release",
      "inherits": "macos-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-x64-debug",
      "displayName": "macOS x64 Debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "macos-x64-release",
      "displayName": "macOS x64 Release",
      "inherits": "macos-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-autograder",
      "displayName": "Linux Autograder",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release"
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64-debug"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64-release"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64-debug"
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release"
    },
    {
      "name": "linux-autograder",
      "configurePreset": "linux-autograder"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-autograder",
      "configurePreset": "linux-autograder",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}


